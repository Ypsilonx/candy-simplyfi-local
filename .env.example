# Zkopíruj do .env a doplň. .env je v .gitignore – klíč do gitu nepatří.
CANDY_IP=192.168.x.x
CANDY_KEY=<16 znaků XOR klíče>

# Ovladač (ovladac/) – vše volitelné, v Dockeru stejné názvy v environment/env_file.
# DRY_RUN=true: příkazy se jen sestaví a vrátí, do myčky nejdou. Ostrý provoz: false.
DRY_RUN=true
# Interval čtení stavu v sekundách (min. 3, appka čte á 15 s).
POLL_SECONDS=15
# Složka s historií cyklů (v Dockeru volume, např. /data).
DATA_DIR=data
